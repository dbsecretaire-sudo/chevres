{
  "expo": {
    "name": "Troupeau Chèvres",
    "slug": "troupeau-chevres",
    "version": "1.0.0",
    "scheme": "troupeauchevres",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.troupeauchevres.app"
    },
    "android": {
      "package": "com.troupeauchevres.app",
      "adaptiveIcon": {
        "backgroundColor": "#3F6B3A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "Troupeau Chèvres",
      "shortName": "Chèvres",
      "description": "Le suivi du troupeau et de la fromagerie.",
      "lang": "fr",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/",
      "themeColor": "#3F6B3A",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Troupeau Chèvres utilise l’appareil photo pour scanner les numéros de boucle."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4f5cf038-915d-4f01-83ef-f90882ee86b5"
      }
    },
    "owner": "fmusic"
  }
}
