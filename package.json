{
  "name": "troupeau-chevres",
  "version": "1.0.179",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.24",
    "expo-auth-session": "~57.0.12",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.10",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "@types/react": "~19.2.2",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "vitest run",
    "bureau:export": "cross-env EXPO_PUBLIC_BUREAU=1 expo export --platform web --clear",
    "bureau": "electron bureau/main.js",
    "bureau:lancer": "npm run bureau:export && npm run bureau",
    "bureau:installateur": "npm run bureau:export && electron-builder --win --publish never"
  },
  "private": true,
  "description": "Troupeau Chèvres",
  "author": "Troupeau Chèvres",
  "build": {
    "appId": "com.troupeauchevres.bureau",
    "productName": "Troupeau Chèvres",
    "directories": {
      "output": "bureau-dist"
    },
    "files": [
      "bureau/**/*",
      "dist/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "bureau/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "language": "1036"
    }
  }
}
